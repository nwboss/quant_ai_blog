---
import { url } from '../../lib/utils';

export interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
  baseUrl?: string;
}

const { currentPage, lastPage, prevUrl, nextUrl, baseUrl = '/blog/' } = Astro.props;

if (lastPage <= 1) {
  // No pagination needed for single page
}
---

{lastPage > 1 && (
  <nav class="flex items-center justify-center gap-2 mt-12" aria-label="分页导航">
    <!-- Prev Button -->
    {prevUrl ? (
      <a
        href={url(prevUrl)}
        class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        上一页
      </a>
    ) : (
      <span class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg border border-slate-100 dark:border-slate-900 text-slate-300 dark:text-slate-700 cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        上一页
      </span>
    )}

    <!-- Page numbers -->
    <div class="flex items-center gap-1">
      {Array.from({ length: lastPage }, (_, i) => i + 1).map((page) => {
        const isCurrent = page === currentPage;
        const rawPageUrl = page === 1 ? baseUrl : `${baseUrl.replace(/\/$/, '')}/page/${page}/`;
        const pageUrl = url(rawPageUrl);
        return (
          <a
            href={pageUrl}
            class={`w-9 h-9 flex items-center justify-center text-sm font-medium rounded-lg transition-colors ${
              isCurrent
                ? 'bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 shadow-sm'
                : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {page}
          </a>
        );
      })}
    </div>

    <!-- Next Button -->
    {nextUrl ? (
      <a
        href={nextUrl}
        class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
      >
        下一页
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg border border-slate-100 dark:border-slate-900 text-slate-300 dark:text-slate-700 cursor-not-allowed">
        下一页
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </span>
    )}
  </nav>
)}
