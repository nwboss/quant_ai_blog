---
import type { SeriesEntry } from '../../lib/content';
import TrackBadge from '../blog/TrackBadge.astro';

export interface Props {
  seriesList: SeriesEntry[];
}

const { seriesList } = Astro.props;
---

{seriesList.length > 0 && (
  <section class="py-12 border-b border-slate-200/80 dark:border-slate-800/80">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight flex items-center gap-2">
          <span>📚</span> 体系化专题专栏
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          循序渐进的系统性学习与投研落地路径
        </p>
      </div>
      <a
        href="/series/"
        class="text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100"
      >
        全部专题 &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {seriesList.map((series) => {
        const slug = series.id.replace(/\.(md|mdx)$/, '');
        return (
          <a
            href={`/series/${slug}/`}
            class="group p-6 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white dark:bg-slate-900 hover:shadow-md transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <TrackBadge track={series.data.track} size="sm" />
                <span class="text-xs font-mono text-slate-400">
                  共 {series.data.posts.length} 篇连载
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors mb-2">
                {series.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {series.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-teal-600 dark:text-teal-400">
              <span>阅读路线 &rarr;</span>
              <span class="font-normal text-slate-400">按序推进</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
