---
import type { PostEntry } from '../../lib/content';
import PostCard from '../blog/PostCard.astro';

export interface Props {
  quantPosts: PostEntry[];
  aiPosts: PostEntry[];
}

const { quantPosts, aiPosts } = Astro.props;
---

<section class="py-12 border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Quant Column -->
    <div>
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200 dark:border-slate-800">
        <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-quant-500"></span>
          量化投研最新文章
        </h3>
        <a
          href="/quant/"
          class="text-xs font-semibold text-quant-600 dark:text-quant-400 hover:underline"
        >
          查看更多 ({quantPosts.length}) &rarr;
        </a>
      </div>

      <div class="space-y-4">
        {quantPosts.length > 0 ? (
          quantPosts.slice(0, 3).map((post) => (
            <PostCard post={post} />
          ))
        ) : (
          <p class="text-sm text-slate-400 py-6 text-center">暂无发布内容</p>
        )}
      </div>
    </div>

    <!-- AI Column -->
    <div>
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-slate-200 dark:border-slate-800">
        <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-ai-500"></span>
          人工智能最新文章
        </h3>
        <a
          href="/ai/"
          class="text-xs font-semibold text-ai-600 dark:text-ai-400 hover:underline"
        >
          查看更多 ({aiPosts.length}) &rarr;
        </a>
      </div>

      <div class="space-y-4">
        {aiPosts.length > 0 ? (
          aiPosts.slice(0, 3).map((post) => (
            <PostCard post={post} />
          ))
        ) : (
          <p class="text-sm text-slate-400 py-6 text-center">暂无发布内容</p>
        )}
      </div>
    </div>
  </div>
</section>
