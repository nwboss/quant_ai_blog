---
import { siteConfig } from '../../site.config';
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../../lib/utils';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full backdrop-blur border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={url('/')} class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-quant-600 via-teal-500 to-ai-600 flex items-center justify-center text-white font-bold text-base shadow-sm group-hover:scale-105 transition-transform">
        Q
      </div>
      <div class="flex flex-col">
        <span class="text-base font-bold tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-quant-600 dark:group-hover:text-quant-400 transition-colors">
          智量双线
        </span>
        <span class="text-[10px] tracking-wider text-slate-400 dark:text-slate-500 uppercase font-mono">
          Quant & AI Lab
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {siteConfig.nav.map((item) => {
        const itemUrl = url(item.href);
        const isActive = item.href === '/' ? currentPath === itemUrl : currentPath.startsWith(itemUrl);
        const isQuant = item.href === '/quant/';
        const isAI = item.href === '/ai/';
        const isNews = item.href === '/news/';

        return (
          <a
            href={itemUrl}
            class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
              isActive
                ? isQuant
                  ? 'text-quant-700 dark:text-quant-400 bg-quant-50 dark:bg-quant-950/60'
                  : isAI
                  ? 'text-ai-700 dark:text-ai-400 bg-ai-50 dark:bg-ai-950/60'
                  : isNews
                  ? 'text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60'
                  : 'text-slate-900 dark:text-slate-100 bg-slate-100 dark:bg-slate-800'
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/60'
            }`}
          >
            <span>{item.title}</span>
            {item.badge && (
              <span class="px-1.5 py-0.2 text-[10px] font-semibold uppercase tracking-wider rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60">
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right utility icons -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Search link -->
      <a
        href={url('/search/')}
        aria-label="搜索全站文章"
        class={`p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors ${
          currentPath.includes('/search') ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-100' : ''
        }`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </a>

      <!-- RSS Feed link -->
      <a
        href={url('/rss.xml')}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="订阅全站 RSS"
        class="p-2 rounded-lg text-slate-500 hover:text-amber-600 dark:text-slate-400 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-8.18v4.819c10.563.061 19.121 8.612 19.183 19.181h4.817c-.062-13.226-10.763-23.937-24-24z"/>
        </svg>
      </a>

      <!-- Dark / Light Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile hamburger menu button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="展开菜单"
        class="md:hidden p-2 rounded-lg text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      >
        <svg id="hamburger-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="hamburger-close" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-2 pb-4 space-y-1">
    {siteConfig.nav.map((item) => {
      const itemUrl = url(item.href);
      const isActive = item.href === '/' ? currentPath === itemUrl : currentPath.startsWith(itemUrl);
      return (
        <a
          href={itemUrl}
          class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
            isActive
              ? 'text-quant-600 dark:text-quant-400 bg-quant-50 dark:bg-quant-950/50 font-semibold'
              : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'
          }`}
        >
          {item.title}
        </a>
      );
    })}
    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-4 text-sm text-slate-500">
      <a href={url('/quant/rss.xml')} class="hover:text-quant-600">量化 RSS</a>
      <a href={url('/ai/rss.xml')} class="hover:text-ai-600">AI RSS</a>
      <a href={url('/news/rss.xml')} class="hover:text-amber-600">快讯 RSS</a>
      <a href={url('/tags/')} class="hover:text-slate-900 dark:hover:text-slate-100">全站标签</a>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('hamburger-open');
  const closeIcon = document.getElementById('hamburger-close');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menu?.classList.toggle('hidden');
    if (!isExpanded) {
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });
</script>
