---
import PageLayout from '../layouts/PageLayout.astro';
import { getPublicPosts, getPostSlug, formatLabels } from '../lib/content';
import { formatDate } from '../lib/utils';

const allPosts = await getPublicPosts();
const searchData = allPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  track: post.data.track,
  format: formatLabels[post.data.format] || post.data.format,
  tags: post.data.tags,
  date: formatDate(post.data.publishedAt),
  url: `/blog/${getPostSlug(post)}/`,
}));
---

<PageLayout
  title="站内全文检索"
  description="支持跨标题、正文、量化模型与 AI 关键词搜索。可在搜索结果中按主线频道进行筛选。"
  headline="SEARCH"
>
  <div class="max-w-3xl">
    <!-- Search Bar -->
    <div class="relative mb-6">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input
        type="text"
        id="search-input"
        placeholder="输入关键词搜索（如：动量、Agent、IC、夏普、回测）..."
        autocomplete="off"
        class="w-full pl-11 pr-10 py-3.5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent text-sm transition-all shadow-xs"
      />
      <button
        type="button"
        id="clear-btn"
        class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Filter Pills -->
    <div class="flex items-center gap-2 mb-8 text-xs font-medium">
      <span class="text-slate-400">频道筛选：</span>
      <button
        type="button"
        data-track="all"
        class="track-filter active px-3 py-1 rounded-lg bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 transition-colors"
      >
        全部
      </button>
      <button
        type="button"
        data-track="quant"
        class="track-filter px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 transition-colors"
      >
        仅量化
      </button>
      <button
        type="button"
        data-track="ai"
        class="track-filter px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 transition-colors"
      >
        仅 AI
      </button>
    </div>

    <!-- Status summary -->
    <div id="search-status" class="text-xs text-slate-400 font-mono mb-6">
      输入关键词以开始检索
    </div>

    <!-- Results Container -->
    <div id="results-container" class="space-y-4"></div>
  </div>
</PageLayout>

<!-- JSON Dataset for fallback and quick indexing -->
<script is:inline id="search-data" type="application/json" set:html={JSON.stringify(searchData)}></script>

<script is:inline>
  const searchInput = document.getElementById('search-input');
  const clearBtn = document.getElementById('clear-btn');
  const resultsContainer = document.getElementById('results-container');
  const searchStatus = document.getElementById('search-status');
  const filterBtns = document.querySelectorAll('.track-filter');
  const dataScript = document.getElementById('search-data');
  const rawData = dataScript ? JSON.parse(dataScript.textContent) : [];

  let selectedTrack = 'all';
  let pagefind = null;

  // Initialize Pagefind if available (in production build)
  async function loadPagefind() {
    try {
      pagefind = await import('/_pagefind/pagefind.js');
      await pagefind.init();
    } catch (e) {
      // Pagefind not found (e.g. In dev mode), fallback smoothly to rawData
    }
  }
  loadPagefind();

  // Focus input automatically
  searchInput?.focus();

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-slate-100', 'dark:text-slate-900');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
      });
      btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-slate-100', 'dark:text-slate-900');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400');
      selectedTrack = btn.getAttribute('data-track') || 'all';
      performSearch();
    });
  });

  searchInput?.addEventListener('input', () => {
    if (searchInput.value.trim().length > 0) {
      clearBtn?.classList.remove('hidden');
    } else {
      clearBtn?.classList.add('hidden');
    }
    performSearch();
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    clearBtn?.classList.add('hidden');
    performSearch();
    searchInput?.focus();
  });

  async function performSearch() {
    const query = searchInput?.value.trim() || '';

    if (!query) {
      if (resultsContainer) resultsContainer.innerHTML = '';
      if (searchStatus) searchStatus.textContent = '输入关键词以开始检索';
      return;
    }

    if (searchStatus) searchStatus.textContent = '正在检索...';

    let matched = [];

    // Try Pagefind if available
    if (pagefind) {
      try {
        const search = await pagefind.search(query);
        const results = await Promise.all(search.results.slice(0, 15).map((r) => r.data()));
        matched = results.map((r) => ({
          title: r.meta.title || '',
          description: r.excerpt || '',
          url: r.url,
          track: r.url.includes('/quant') ? 'quant' : r.url.includes('/ai') ? 'ai' : 'quant',
          format: '文章',
          date: '',
          tags: [],
        }));
      } catch (e) {
        matched = fallbackSearch(query);
      }
    } else {
      matched = fallbackSearch(query);
    }

    // Apply track filter
    if (selectedTrack !== 'all') {
      matched = matched.filter((item) => item.track === selectedTrack);
    }

    renderResults(matched, query);
  }

  function fallbackSearch(query) {
    const q = query.toLowerCase();
    return rawData.filter((post) => {
      const matchTitle = post.title.toLowerCase().includes(q);
      const matchDesc = post.description.toLowerCase().includes(q);
      const matchTags = post.tags.some((t) => t.toLowerCase().includes(q));
      return matchTitle || matchDesc || matchTags;
    });
  }

  function renderResults(results, query) {
    if (!resultsContainer || !searchStatus) return;

    searchStatus.textContent = `检索 “${query}” 找到 ${results.length} 条结果`;

    if (results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-12 text-center border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl">
          <p class="text-slate-500 text-sm">未检索到与 “${query}” 相关的文章</p>
          <p class="text-xs text-slate-400 mt-1">建议尝试更简短的关键词，如“动量”、“Agent”或“因子”</p>
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = results
      .map((item) => {
        const isQuant = item.track === 'quant';
        const trackLabel = isQuant ? '量化' : 'AI';
        const trackClass = isQuant
          ? 'bg-quant-100 text-quant-800 dark:bg-quant-950 dark:text-quant-300'
          : 'bg-ai-100 text-ai-800 dark:bg-ai-950 dark:text-ai-300';

        return `
          <a
            href="${item.url}"
            class="block p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-md transition-all group"
          >
            <div class="flex items-center gap-2 mb-2 text-xs">
              <span class="px-2 py-0.5 rounded-full font-medium ${trackClass}">
                ${trackLabel}
              </span>
              <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500">
                ${item.format}
              </span>
              ${item.date ? `<span class="text-slate-400 font-mono ml-auto">${item.date}</span>` : ''}
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors mb-1.5">
              ${item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
              ${item.description}
            </p>
          </a>
        `;
      })
      .join('');
  }
</script>
