---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import { getPublicPosts } from '../../../lib/content';

export async function getStaticPaths() {
  const PAGE_SIZE = 6;
  const posts = await getPublicPosts();
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);

  if (totalPages <= 1) {
    return [];
  }

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const pageNum = i + 2;
    const start = (pageNum - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    return {
      params: { page: String(pageNum) },
      props: {
        posts: posts.slice(start, end),
        pageNum,
        totalPages,
      },
    };
  });
}

const { posts, pageNum, totalPages } = Astro.props;
const prevUrl = pageNum === 2 ? '/blog/' : `/blog/page/${pageNum - 1}/`;
const nextUrl = pageNum < totalPages ? `/blog/page/${pageNum + 1}/` : undefined;
---

<BaseLayout
  title={`全部文章归档 (第 ${pageNum} 页)`}
  description={`按时间倒序查阅技术博客文章，当前为第 ${pageNum} 页。`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-medium text-slate-500 mb-3">
        <a href="/blog/" class="hover:underline">&larr; 返回首批文章</a>
        <span>&middot;</span>
        <span>第 {pageNum} / {totalPages} 页</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
        全部文章归档
      </h1>
    </header>

    <!-- Post Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post: any) => (
        <PostCard post={post} />
      ))}
    </div>

    <!-- Pagination -->
    <Pagination
      currentPage={pageNum}
      lastPage={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      baseUrl="/blog/"
    />
  </div>
</BaseLayout>
