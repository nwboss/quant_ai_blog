---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 (404)">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-slate-100 dark:bg-slate-800 text-slate-400 font-mono text-3xl font-bold mb-6">
      404
    </div>

    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-4 tracking-tight">
      抱歉，该页面似乎不存在
    </h1>

    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-8 max-w-md mx-auto">
      可能是文章链接已变更，或者该内容正在撰写或处于草稿阶段未予公开。你可以通过站内检索寻找目标内容。
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 text-sm font-semibold hover:bg-slate-800 transition-colors"
      >
        返回博客首页
      </a>
      <a
        href="/search/"
        class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
      >
        站内全文检索
      </a>
    </div>
  </div>
</BaseLayout>
