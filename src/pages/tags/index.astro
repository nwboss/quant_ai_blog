---
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllTags } from '../../lib/content';

const tags = await getAllTags();
---

<PageLayout
  title="全站主题标签"
  description="按具体技术、策略类型与模型主题跨主线检索全部研究文章与实践手记。"
  headline="TAGS ARCHIVE"
>
  <div class="max-w-4xl">
    <div class="flex flex-wrap gap-3">
      {tags.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag.name)}/`}
          class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-teal-500/50 hover:shadow-sm transition-all"
        >
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
            #{tag.name}
          </span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-mono">
            {tag.count}
          </span>
        </a>
      ))}
    </div>
  </div>
</PageLayout>
