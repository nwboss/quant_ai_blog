---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import TrackBadge from '../../components/blog/TrackBadge.astro';
import { getPublicSeries, getPublicPosts, getPostSlug, type SeriesEntry, type PostEntry } from '../../lib/content';
import { formatDate } from '../../lib/utils';
import { getReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const seriesList = await getPublicSeries();
  const allPosts = await getPublicPosts();

  return seriesList.map((series) => {
    const slug = series.id.replace(/\.(md|mdx)$/, '');
    // Resolve post objects in the specified order
    const orderedPosts = series.data.posts
      .map((postSlug) => allPosts.find((p) => getPostSlug(p) === postSlug))
      .filter((p): p is PostEntry => Boolean(p));

    return {
      params: { slug },
      props: { series, posts: orderedPosts },
    };
  });
}

export interface Props {
  series: SeriesEntry;
  posts: PostEntry[];
}

const { series, posts } = Astro.props;
const { Content } = await render(series);
---

<PageLayout
  title={series.data.title}
  description={series.data.description}
  headline="SERIES ROADMAP"
>
  <div class="max-w-4xl">
    <!-- Series Intro Card -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 mb-10">
      <div class="flex items-center gap-2 mb-3">
        <TrackBadge track={series.data.track} size="sm" />
        <span class="text-xs text-slate-500 font-mono">
          包含 {posts.length} 篇循序进阶篇目
        </span>
      </div>
      <div class="prose prose-slate dark:prose-invert max-w-none text-sm leading-relaxed">
        <Content />
      </div>
    </div>

    <!-- Step List -->
    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-6">
      学习步骤与文章清单
    </h2>

    <div class="space-y-6 relative before:absolute before:inset-0 before:left-6 before:w-0.5 before:bg-slate-200 dark:before:bg-slate-800">
      {posts.map((post, index) => {
        const slug = getPostSlug(post);
        const reading = getReadingTime(post.body || '');

        return (
          <div class="relative flex items-start gap-6 group">
            <!-- Step Number Badge -->
            <div class="relative z-10 w-12 h-12 rounded-2xl bg-white dark:bg-slate-900 border-2 border-slate-200 dark:border-slate-800 group-hover:border-teal-500 flex items-center justify-center font-bold text-slate-700 dark:text-slate-300 group-hover:text-teal-600 transition-colors shadow-xs">
              0{index + 1}
            </div>

            <!-- Content Card -->
            <div class="flex-1 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 group-hover:border-slate-300 dark:group-hover:border-slate-700 group-hover:shadow-md transition-all">
              <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2">
                <span>步骤 {index + 1}</span>
                <span>{formatDate(post.data.publishedAt)} &middot; {reading.text}</span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2">
                <a
                  href={`/blog/${slug}/`}
                  class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
                >
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
                {post.data.description}
              </p>

              <div class="flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
                <div class="flex gap-2">
                  {post.data.tags.map((t) => (
                    <span class="text-slate-400">#{t}</span>
                  ))}
                </div>
                <a
                  href={`/blog/${slug}/`}
                  class="font-semibold text-teal-600 dark:text-teal-400 hover:underline"
                >
                  开始阅读 &rarr;
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</PageLayout>
