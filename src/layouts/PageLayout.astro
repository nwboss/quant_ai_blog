---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  headline?: string;
}

const { title, description, headline } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-10 max-w-3xl">
      {headline && (
        <p class="text-xs font-semibold uppercase tracking-wider text-quant-600 dark:text-quant-400 mb-2">
          {headline}
        </p>
      )}
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight mb-4">
        {title}
      </h1>
      {description && (
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          {description}
        </p>
      )}
    </header>

    <!-- Page Body -->
    <slot />
  </div>
</BaseLayout>
